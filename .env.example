# Copy this file to .env and fill in your own values. .env is gitignored; never commit it.
#   cp .env.example .env
#
# Only `npm run eval:trace` reads .env. The shop app (npm start / npm run app) never does,
# and never sends anything to Sentry. See docs/EVALUATION.md → "Tracing an evaluation with Sentry".

# Sentry DSN for the optional evaluation tracing (synthetic or fixture data only).
# Find it in Sentry: Settings → Projects → <your Node.js project> → Client Keys (DSN).
# Leave it empty to keep tracing off.
SENTRY_DSN=
