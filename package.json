{
  "name": "parchimatch-lite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns messy wholesale order lines into reviewed catalogue rows with a local model. Harness + pipeline.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "app": "node --disable-warning=ExperimentalWarning src/start.ts",
    "label": "node --disable-warning=ExperimentalWarning src/label.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "eval": "node --disable-warning=ExperimentalWarning src/eval.ts",
    "eval:baselines": "node --disable-warning=ExperimentalWarning src/eval.ts --methods exact,fuzzy",
    "split": "node --disable-warning=ExperimentalWarning src/split.ts",
    "check-leak": "node --disable-warning=ExperimentalWarning src/checkleak.ts",
    "export-train": "node --disable-warning=ExperimentalWarning src/exporttrain.ts"
  }
}
